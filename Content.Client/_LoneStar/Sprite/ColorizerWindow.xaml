<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="560 360"
               SetSize="680 440">
    <BoxContainer Orientation="Vertical"
            Margin="4">
        <BoxContainer Orientation="Horizontal"
                VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                    MinWidth="200"
                    Margin="0 0 8 0">
                <Label Text="{Loc 'colorizer-composition'}"
                       StyleClasses="LabelHeading"
                        Margin="0 8 0 2"/>
                <PanelContainer StyleClasses="Inset"
                        SetSize="184 184">
                    <SpriteView Name="CompositionPreview"
                                SetSize="184 184"
                                Scale="4 4"
                                OverrideDirection="South"/>
                </PanelContainer>
                <BoxContainer Name="VariantList"
                              Orientation="Vertical"
                              SetWidth="184"
                              Margin="0 8 0 0"/>
                <Button Name="RandomizeButton"
                        SetWidth="184"
                        Margin="0 4 0 0"/>
            </BoxContainer>
            <ScrollContainer HorizontalExpand="True"
                    VerticalExpand="True">
                <BoxContainer Name="PaletteList"
                        Orientation="Vertical"/>
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
